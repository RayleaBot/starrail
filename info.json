{
  "id": "raylea.starrail",
  "name": "崩坏：星穹铁道",
  "version": "0.1.0",
  "manifest_version": "4",
  "min_core_version": "0.4.0",
  "license": "AGPL-3.0-only",
  "metadata": {
    "repo": "https://github.com/RayleaBot/starrail",
    "description": "崩坏：星穹铁道独立查询、离线图鉴、公开展柜与抽卡档案",
    "author": "raylea"
  },
  "dependencies": [
    {
      "id": "raylea.mihoyo-accounts",
      "requirement": "recommended",
      "reason": "绑定 UID、便笺、签到与抽卡同步等账号功能需要米游社账号"
    }
  ],
  "concurrency": 4,
  "command_prefixes": {
    "dedicated": [
      "*",
      "＊",
      "星铁",
      "星轨",
      "崩铁",
      "星穹铁道",
      "铁道",
      "sr"
    ],
    "settings_key": "command_prefixes",
    "accept_global": false
  },
  "events": [
    "message.private",
    "message.group",
    "config.changed",
    "scheduler.trigger"
  ],
  "default_config": {
    "account_provider": "raylea.mihoyo-accounts",
    "image_replies": true,
    "custom_aliases": {},
    "command_prefixes": [
      "*",
      "＊",
      "星铁",
      "星轨",
      "崩铁",
      "星穹铁道",
      "铁道",
      "sr"
    ],
    "alias_permission": 0,
    "ark": {
      "panel_rank": true,
      "query_type": 3,
      "rank_type": 2,
      "local_panel_rank": true,
      "mark_rank_type": false,
      "profile_change_diff": true,
      "deal_long_dmg_title": 1,
      "profile_change_ocr": true,
      "export_panel_data": 1,
      "import_panel_data": 2,
      "export_panel_require": 1,
      "group_rank": true,
      "local_group_rank": true,
      "new_user_panel": false
    }
  },
  "commands": [
    {
      "id": "profile",
      "name": "卡片",
      "description": "玩家信息与角色展示卡片",
      "usage": "#卡片 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:卡片|探索|角色)(?P<uid>[0-9]{9,10})?$"
      }
    },
    {
      "id": "note",
      "name": "体力",
      "description": "开拓力、每日实训与委托派遣等实时便笺",
      "usage": "#体力",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "体力",
          "树脂",
          "查询体力"
        ]
      }
    },
    {
      "id": "panel-refresh-account",
      "name": "米游社更新面板",
      "description": "从已绑定账号的米游社数据更新全部角色的面板与行迹并保存",
      "usage": "#米游社更新面板 / #刷新行迹",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:(?:米游社|mys)(?:全部面板更新|更新全部面板|获取游戏角色详情|更新面板|面板更新)(?P<uid>[0-9]{9,10})?|(?:强制)?(?:刷新|更新)(?:所有|角色)*(?:行迹|技能|天赋))$"
      }
    },
    {
      "id": "talent-wiki",
      "name": "角色天赋",
      "description": "角色的技能、行迹与星魂资料",
      "usage": "#<角色>天赋 / #<角色>星魂",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?P<character>.+?)(?:天赋|技能|行迹|星魂)$"
      }
    },
    {
      "id": "monthly-history",
      "name": "星琼统计",
      "description": "保存官方仍提供的月份后，统计最近十二个月或指定年份的星琼与专票、通票",
      "usage": "#[去年|今年|<年份>年]星琼统计 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:去年|今年|[0-9]{4}年)?(?:星琼|月报)统计$"
      }
    },
    {
      "id": "ledger",
      "name": "星琼",
      "description": "本月或前两个月的星琼与专票、通票收入（开拓月历）",
      "usage": "#星琼[月份] [UID] / #月历",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:星琼(?P<month>(?:[0-9]|[一二两三四五六七八九十]+)*)月*|月历|星琼获取|月收入|收入|原石)$"
      }
    },
    {
      "id": "training",
      "name": "练度统计",
      "description": "全部角色的等级、星魂、行迹、光锥与遗器评分",
      "usage": "#练度统计",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:面板|喵喵)?练度统计$"
      }
    },
    {
      "id": "accounts",
      "name": "账号",
      "description": "查看已绑定的 UID（账号与无 CK 绑定），uid加序号切换",
      "usage": "#uid[序号]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:账号|(?i:(?:我的)?uid)[0-9]{0,2})$"
      }
    },
    {
      "id": "panel-refresh",
      "name": "更新面板",
      "description": "从 Mihomo 读取游戏内角色展柜的面板并保存",
      "usage": "#更新面板 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:全部面板更新|更新全部面板|获取游戏角色详情|更新面板|面板更新)(?P<uid>[0-9]{9,10})?$"
      }
    },
    {
      "id": "panel-list",
      "name": "面板列表",
      "description": "列出本人或所写 UID 已保存面板的角色",
      "usage": "#面板列表 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:(?:面板角色|角色面板|面板)(?:列表)?|(?:加载|重新加载|重载)面板)(?P<uid>[0-9]{9,10})?$"
      }
    },
    {
      "id": "panel-delete",
      "name": "删除面板",
      "description": "删除本人 UID 已保存的面板与群排名",
      "usage": "#删除面板<UID>",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:删除全部面板|删除面板|删除面板数据)(?P<uid>[0-9]{9,10})?$"
      }
    },
    {
      "id": "artifact-list",
      "name": "遗器列表",
      "description": "已保存面板中评分最高的遗器",
      "usage": "#遗器列表 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:遗器|圣遗物)列表(?P<uid>[0-9]{9,10})?$"
      }
    },
    {
      "id": "gacha-help",
      "name": "抽卡帮助",
      "description": "跃迁记录页链接的获取方法；私聊或群聊直接发送该链接即可读取全部跃迁记录",
      "usage": "#抽卡帮助 / #抽卡链接",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "抽卡帮助",
          "记录帮助",
          "跃迁帮助",
          "抽卡链接",
          "抽卡链接绑定"
        ]
      }
    },
    {
      "id": "pay-log",
      "name": "资产记录",
      "description": "按页查看星琼、古老梦华、开拓力、遗器与光锥的获取记录，写“消耗”或“全部”改看消耗或全部变动",
      "usage": "#<星琼|古老梦华|体力|遗器>[消耗|全部]记录[页码] / #光锥<获取|消耗|全部>记录[页码]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:(?P<type>星琼|古老梦华|开拓力|体力|遗器|充值)(?P<direction>获取|消耗|全部)?|(?P<cone>光锥)(?P<cone_direction>获取|消耗|全部)|资产)记录(?P<page>[0-9]*)$"
      }
    },
    {
      "id": "gacha",
      "name": "跃迁记录",
      "description": "分析已保存的跃迁记录：总览各跃迁的五星与持有率，写卡池时按期列出该跃迁的四星与五星；联动为角色联动跃迁",
      "usage": "#跃迁记录 [UID] / #<角色|光锥|常驻|联动|光锥联动|新手>记录 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:喵喵)?(?:角色联动|光锥联动|武器联动|联动|角色|光锥|武器|常驻|新手|集录|up|全部|抽卡|抽奖|跃迁)*池*(?:记录|分析|祈愿)(?P<uid>[0-9]{9,10})?$"
      }
    },
    {
      "id": "gacha-stat",
      "name": "抽卡统计",
      "description": "按版本逐期统计 UP、抽数与所得四星、五星；不写卡池时统计角色与光锥活动跃迁，常驻、联动、新手与全部各合为一栏",
      "usage": "#抽卡统计 [UID] / #<角色|光锥|常驻|联动|新手|全部>统计 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:喵喵)?(?:角色联动|光锥联动|武器联动|联动|角色|光锥|武器|常驻|新手|集录|up|全部|抽卡|抽奖|跃迁|版本)*池*统计(?P<uid>[0-9]{9,10})?$"
      }
    },
    {
      "id": "swarm",
      "name": "寰宇蝗灾",
      "description": "寰宇蝗灾战绩",
      "usage": "#寰宇蝗灾 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:寰宇)?蝗灾(?P<uid>[0-9]{9,10})?$"
      }
    },
    {
      "id": "gears",
      "name": "黄金与机械",
      "description": "黄金与机械战绩",
      "usage": "#黄金与机械 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "黄金与机械",
          "黄金机械",
          "黄金",
          "机械"
        ]
      }
    },
    {
      "id": "unknowable",
      "name": "不可知域",
      "description": "不可知域战绩",
      "usage": "#不可知域 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "不可知域"
        ]
      }
    },
    {
      "id": "divergent",
      "name": "差分宇宙",
      "description": "差分宇宙战绩",
      "usage": "#差分宇宙 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:差分宇宙|差分)(?P<uid>[0-9]{9,10})?$"
      }
    },
    {
      "id": "currency_wars",
      "name": "货币战争",
      "description": "货币战争的晋升等级、职级与最新通关战绩",
      "usage": "#货币战争",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "货币战争",
          "货币",
          "币战"
        ]
      }
    },
    {
      "id": "gacha-summary",
      "name": "跃迁摘要",
      "description": "官方五星记录与卡池统计，不是完整逐抽历史",
      "usage": "#跃迁摘要 [卡池] [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "跃迁摘要"
        ]
      }
    },
    {
      "id": "group-settings",
      "name": "群设置",
      "description": "查看或调整本群的游戏开关、图片或文字回复与本群别名，别名目标可写角色或光锥的名称、别名或资料 ID",
      "usage": "#群设置 [开启|关闭|图片|文本|默认] / #群设置 别名 <名称> <角色或光锥> / #群设置 删除别名 <名称>",
      "permission": "group_admin",
      "trigger": {
        "type": "exact",
        "names": [
          "群设置"
        ]
      }
    },
    {
      "id": "alias-remove",
      "name": "删除别名",
      "description": "删除对所有群生效的自定义别名，预设别名不能删除",
      "usage": "#删除别名 <别名>",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:喵喵别名(?:[崩星]铁)?删除|删除(?:别名|昵称)(?P<alias>.*))$"
      }
    },
    {
      "id": "alias-add",
      "name": "添加别名",
      "description": "给角色添加对所有群生效的自定义别名，发送后按提示再发别名，多个用空格隔开",
      "usage": "#设置<角色>别名",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:喵喵别名(?:[崩星]铁)?设置|(?:设置|配置|添加)(?P<character>.+)(?:别名|昵称))$"
      }
    },
    {
      "id": "aliases",
      "name": "角色别名",
      "description": "查看角色的全部别名；不写角色时列出全部自定义别名与别名命令",
      "usage": "#<角色>别名 / #别名列表",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:(?:喵喵)?别名(?:[崩星]铁)?(?:列表|帮助)?|(?P<character>.+?)(?:别名|昵称))$"
      }
    },
    {
      "id": "simulation-history",
      "name": "模拟记录",
      "description": "查看本人的模拟抽卡记录",
      "usage": "#模拟记录",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "模拟记录"
        ]
      }
    },
    {
      "id": "simulation-reset",
      "name": "重置模拟",
      "description": "清空本人的模拟抽卡记录",
      "usage": "#重置模拟 确认",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "重置模拟"
        ]
      }
    },
    {
      "id": "signin",
      "name": "签到",
      "description": "游戏每日签到，领取签到奖励",
      "usage": "#签到 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "签到",
          "游戏签到"
        ]
      }
    },
    {
      "id": "signin-status",
      "name": "签到状态",
      "description": "查看本月游戏签到情况",
      "usage": "#签到状态 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "签到状态",
          "签到查询"
        ]
      }
    },
    {
      "id": "signin-task",
      "name": "自动签到",
      "description": "显式开启或停止每日自动签到",
      "usage": "#自动签到 <开启|关闭> [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "自动签到"
        ]
      }
    },
    {
      "id": "public-profile",
      "name": "公开信息",
      "description": "用本人主动共享的查询账号查看任意国服 UID 的公开资料，不写区服时按 UID 判断官服或B服",
      "usage": "#公开信息 <UID> [官服|B服]",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "公开信息"
        ]
      }
    },
    {
      "id": "cloud-verify-code",
      "name": "ark绑定星铁uid",
      "description": "向 ark 获取当前 UID 的验证码，设为游戏签名后用于验证 UID 拥有者",
      "usage": "#ark绑定星铁uid",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "ark绑定星铁uid"
        ]
      }
    },
    {
      "id": "cloud-verify",
      "name": "ark验证星铁uid",
      "description": "签名生效后由 ark 验证 UID 拥有者，通过后 UID 与 QQ 绑定（仅 OneBot11）",
      "usage": "#ark验证星铁uid",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "ark验证星铁uid"
        ]
      }
    },
    {
      "id": "gacha-background",
      "name": "更新跃迁记录",
      "description": "按 StarRail-plugin 用最近发送的抽卡链接重新读取跃迁记录，同一 UID 一小时一次",
      "usage": "#更新跃迁记录",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "更新跃迁记录",
          "更新跃迁",
          "更新抽卡",
          "更新抽卡记录"
        ]
      }
    },
    {
      "id": "gacha-export",
      "name": "导出记录",
      "description": "导出跃迁记录为 UIGF 文件；导出记录在群聊中需写强制，导出抽卡记录（导出跃迁记录同义）同 StarRail-plugin 直接发送 UIGF v4",
      "usage": "#导出记录 [v2] / #导出抽卡记录",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:(?:星铁)?(?P<force>强制)?导出记录(?:json)?(?P<version>v2|v4)?|导出(?:抽卡|跃迁)记录(?:json)?)$"
      }
    },
    {
      "id": "gacha-import",
      "name": "导入记录",
      "description": "发送 UIGF 或 SRGF 文件导入跃迁记录",
      "usage": "#导入记录",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:星铁)?(?P<force>强制)?导入记录(?:json)?$"
      }
    },
    {
      "id": "challenge-submit",
      "name": "提交挑战",
      "description": "主动向当前群公开本人成绩",
      "usage": "#提交挑战 <玩法> [本期|上期] [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "提交挑战"
        ]
      }
    },
    {
      "id": "challenge-rank",
      "name": "挑战排行",
      "description": "分期查看群挑战榜；参数按顺序填写，翻页时期次与指标不能省略（可写全部、综合）",
      "usage": "#挑战排行 <玩法> [本期|上期|全部] [指标] [页码]",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "挑战排行"
        ]
      }
    },
    {
      "id": "challenge-withdraw",
      "name": "退出挑战",
      "description": "移除本人的群榜记录",
      "usage": "#退出挑战 [玩法]",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "退出挑战"
        ]
      }
    },
    {
      "id": "challenge-clear",
      "name": "清空挑战",
      "description": "群管理员清空本群挑战群榜，可只清空一种玩法",
      "usage": "#清空挑战 [玩法]",
      "permission": "group_admin",
      "trigger": {
        "type": "exact",
        "names": [
          "清空挑战"
        ]
      }
    },
    {
      "id": "challenge-remind",
      "name": "挑战提醒",
      "description": "显式开启本人挑战完成提醒",
      "usage": "#挑战提醒 <玩法> <指标> <阈值> [时间] [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "挑战提醒"
        ]
      }
    },
    {
      "id": "challenge-stop",
