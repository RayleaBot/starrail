  "manifest_version": "4",
  "min_core_version": "0.7.0",
  "license": "AGPL-3.0-only",
  "metadata": {
    "description": "崩坏：星穹铁道独立查询、离线图鉴、公开展柜与抽卡档案",
    "author": "raylea"
  },
  "concurrency": 4,
  "command_prefixes": {
    "dedicated": [
      "*",
      "＊",
      "星铁",
      "星轨",
      "崩铁",
      "星穹铁道",
      "铁道",
      "sr"
    ],
    "settings_key": "command_prefixes",
    "accept_global": false
  },
  "events": [
    "message.private",
    "message.group",
    "config.changed",
    "scheduler.trigger",
    "notice.poke"
  ],
  "default_config": {
    "account_provider": "raylea.mihoyo-accounts",
    "image_replies": true,
    "custom_aliases": {},
