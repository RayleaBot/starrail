{
  "id": "raylea.starrail",
  "name": "崩坏：星穹铁道",
  "version": "0.1.0",
  "manifest_version": "4",
  "min_core_version": "0.7.0",
  "license": "AGPL-3.0-only",
  "metadata": {
    "description": "崩坏：星穹铁道独立查询、离线图鉴、公开展柜与抽卡档案",
    "author": "raylea"
  },
  "concurrency": 4,
  "command_prefixes": {
    "dedicated": [
      "*",
      "＊",
      "星铁",
      "星轨",
      "崩铁",
      "星穹铁道",
      "铁道",
      "sr"
    ],
    "settings_key": "command_prefixes",
    "accept_global": false
  },
  "events": [
    "message.private",
    "message.group",
    "config.changed",
    "scheduler.trigger"
  ],
  "default_config": {
    "account_provider": "raylea.mihoyo-accounts",
    "image_replies": true,
    "custom_aliases": {},
    "command_prefixes": [
      "*",
      "＊",
      "星铁",
      "星轨",
      "崩铁",
      "星穹铁道",
      "铁道",
      "sr"
    ],
    "alias_permission": 0,
    "panel_api": 1,
    "ark": {
      "panel_rank": true,
      "query_type": 3,
      "rank_type": 2,
      "local_panel_rank": true,
      "mark_rank_type": false,
      "profile_change_diff": true,
      "deal_long_dmg_title": 1,
      "profile_change_ocr": true,
      "export_panel_data": 1,
      "import_panel_data": 2,
      "export_panel_require": 1,
      "group_rank": true,
      "local_group_rank": true,
      "new_user_panel": false
    }
  },
  "commands": [
    {
      "id": "profile",
      "name": "卡片",
      "description": "玩家信息与角色展示卡片",
      "usage": "#卡片 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:卡片|探索|角色)(?P<uid>[0-9]{9,10})?$"
      }
    },
    {
      "id": "note",
      "name": "体力",
      "description": "开拓力、每日实训与委托派遣等实时便笺",
      "usage": "#体力",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "体力",
          "树脂",
          "查询体力"
        ]
      }
    },
    {
      "id": "panel-refresh-account",
      "name": "米游社更新面板",
      "description": "从已绑定账号的米游社数据更新全部角色面板并保存",
      "usage": "#米游社更新面板",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:(?:米游社|mys)(?:全部面板更新|更新全部面板|获取游戏角色详情|更新面板|面板更新)(?P<uid>[0-9]{9,10})?)$"
      }
    },
    {
      "id": "talent-refresh",
      "name": "刷新行迹",
      "description": "从米游社重新读取全部角色的行迹，供练度统计使用",
      "usage": "#刷新行迹",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:强制)?(?:刷新|更新)(?:所有|角色)*(?:行迹|技能|天赋)$"
      }
    },
    {
      "id": "talent-wiki",
      "name": "角色天赋",
      "description": "角色的技能、行迹与星魂资料",
      "usage": "#希儿天赋 / #希儿星魂",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?P<character>.+?)(?:天赋|技能|行迹|星魂)$"
      }
    },
    {
      "id": "monthly-history",
      "name": "星琼统计",
      "description": "保存官方仍提供的月份后，统计最近十二个月或指定年份的星琼与专票、通票",
      "usage": "#[去年|今年|2025年]星琼统计 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:去年|今年|[0-9]{4}年)?(?:星琼|月报)统计$"
      }
    },
    {
      "id": "ledger",
      "name": "星琼",
      "description": "本月或前两个月的星琼与专票、通票收入（开拓月历）",
      "usage": "#星琼[月份] [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^星琼(?P<month>(?:[0-9]|[一二两三四五六七八九十]+)*)月*$"
      }
    },
    {
      "id": "training",
      "name": "练度统计",
      "description": "全部角色的等级、星魂、行迹、光锥与遗器评分",
      "usage": "#练度统计",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:面板|喵喵)?练度统计$"
      }
    },
    {
      "id": "accounts",
      "name": "账号",
      "description": "查看已绑定的 UID（账号与无 CK 绑定），uid加序号切换",
      "usage": "#uid / #uid2",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:账号|(?i:(?:我的)?uid)[0-9]{0,2})$"
      }
    },
    {
      "id": "api-panel-refresh",
      "name": "面板更新",
      "description": "按 StarRail-plugin 从面板服务更新面板，列出本次更新的角色，随后同 miao 更新展柜面板",
      "usage": "#面板更新 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^面板更新(?P<uid>[0-9]{9,10})?$"
      }
    },
    {
      "id": "api-panel-list",
      "name": "面板",
      "description": "按 StarRail-plugin 列出面板服务保存的角色",
      "usage": "#面板列表",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "面板",
          "面板列表"
        ]
      }
    },
    {
      "id": "panel-refresh",
      "name": "更新面板",
      "description": "从 Mihomo 读取游戏内角色展柜的面板并保存",
      "usage": "#更新面板 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:全部面板更新|更新全部面板|获取游戏角色详情|更新面板)(?P<uid>[0-9]{9,10})?$"
      }
    },
    {
      "id": "panel-list",
      "name": "面板列表",
      "description": "已保存面板的角色列表",
      "usage": "#面板列表<UID>",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:(?:面板角色|角色面板|面板)(?:列表)?|(?:加载|重新加载|重载)面板)(?P<uid>[0-9]{9,10})?$"
      }
    },
    {
      "id": "panel-delete",
      "name": "删除面板",
      "description": "删除本人 UID 已保存的面板与群排名",
      "usage": "#删除面板<UID>",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:删除全部面板|删除面板|删除面板数据)(?P<uid>[0-9]{9,10})?$"
      }
    },
    {
      "id": "artifact-list",
      "name": "遗器列表",
      "description": "已保存面板中评分最高的遗器",
      "usage": "#遗器列表 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:遗器|圣遗物)列表(?P<uid>[0-9]{9,10})?$"
      }
    },
    {
      "id": "gacha-help",
      "name": "抽卡帮助",
      "description": "跃迁记录的获取与查看方法",
      "usage": "#抽卡帮助",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "抽卡帮助",
          "记录帮助",
          "跃迁帮助"
        ]
      }
    },
    {
      "id": "gacha-link",
      "name": "抽卡链接",
      "description": "按 StarRail-plugin 提示发送抽卡链接，群聊中也可发送",
      "usage": "#抽卡链接",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "抽卡链接",
          "抽卡链接绑定"
        ]
      }
    },
    {
      "id": "gacha",
      "name": "跃迁记录",
      "description": "分析已导入的抽卡记录",
      "usage": "#跃迁记录 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:角色|光锥|武器|常驻|新手)?(?:跃迁|抽卡)?(?:记录|分析|统计)"
      }
    },
    {
      "id": "gacha-detail",
      "name": "喵喵抽卡记录",
      "description": "按 miao 列出所选跃迁每个五星的日期、是否 UP 与所用抽数",
      "usage": "#喵喵抽卡记录 / #喵喵光锥记录 / #角色池记录 / #up记录 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:喵喵)?(?:抽卡|抽奖|角色|武器|光锥|常驻|集录|up)+池?(?:记录|祈愿|分析)$"
      }
    },
    {
      "id": "gacha-stat",
      "name": "喵喵抽卡统计",
      "description": "按 miao 逐期列出跃迁的 UP、抽数与所得四星、五星",
      "usage": "#喵喵抽卡统计 / #喵喵角色统计 / #全部统计 / #up统计 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:喵喵)?(?:全部|抽卡|抽奖|角色|武器|光锥|常驻|集录|up|版本)+池?统计$"
      }
    },
    {
      "id": "gacha-log",
      "name": "抽卡记录",
      "description": "按 Yunzai 统计所选跃迁的抽数、五星与出金抽数，全部记录列出各跃迁",
      "usage": "#全部记录 / #角色联动记录 / #光锥联动记录 / #新手池记录 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:全部)?(?:抽卡|抽奖|角色|角色联动|武器|武器联动|集录|常驻|up|新手|光锥|光锥联动|全部)池*(?:记录|祈愿|分析)$"
      }
    },
    {
      "id": "gacha-versions",
      "name": "抽卡统计",
      "description": "按 Yunzai 逐期列出卡池的抽数与所得四星、五星及次数",
      "usage": "#新手池统计 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:抽卡|抽奖|角色|武器|常驻|up|新手|光锥)池*统计$"
      }
    },
    {
      "id": "monthly",
      "name": "月历",
      "description": "本月或指定月份的星琼与票券收入（开拓月历）",
      "usage": "#月历",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "月历",
          "星琼获取",
          "月收入",
          "收入",
          "原石"
        ]
      }
    },
    {
      "id": "swarm",
      "name": "寰宇蝗灾",
      "description": "寰宇蝗灾战绩",
      "usage": "#寰宇蝗灾 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:寰宇)?蝗灾(?P<uid>[0-9]{9,10})?$"
      }
    },
    {
      "id": "gears",
      "name": "黄金与机械",
      "description": "黄金与机械战绩",
      "usage": "#黄金与机械 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "黄金与机械",
          "黄金机械",
          "黄金",
          "机械"
        ]
      }
    },
    {
      "id": "unknowable",
      "name": "不可知域",
      "description": "不可知域战绩",
      "usage": "#不可知域 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "不可知域"
        ]
      }
    },
    {
      "id": "divergent",
      "name": "差分宇宙",
      "description": "差分宇宙战绩",
      "usage": "#差分宇宙 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:差分宇宙|差分)(?P<uid>[0-9]{9,10})?$"
      }
    },
    {
      "id": "currency_wars",
      "name": "货币战争",
      "description": "货币战争的晋升等级、职级与最新通关战绩",
      "usage": "#货币战争",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "货币战争",
          "货币",
          "币战"
        ]
      }
    },
    {
      "id": "gacha-summary",
      "name": "跃迁摘要",
      "description": "官方五星记录与卡池统计，不是完整逐抽历史",
      "usage": "#跃迁摘要 [卡池] [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "跃迁摘要"
        ]
      }
    },
    {
      "id": "group-settings",
      "name": "群设置",
      "description": "调整当前群的游戏设置",
      "usage": "#群设置 [开启|关闭|图片|文本|默认|别名|删除别名]",
      "permission": "group_admin",
      "trigger": {
        "type": "exact",
        "names": [
          "群设置"
        ]
      }
    },
    {
      "id": "alias-help",
      "name": "别名帮助",
      "description": "自定义别名命令的说明",
      "usage": "#喵喵别名帮助",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^喵喵别名(?:帮助)?$"
      }
    },
    {
      "id": "alias-set",
      "name": "设置别名",
      "description": "给角色添加对所有群生效的自定义别名",
      "usage": "#喵喵别名设置 角色名 别名",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^喵喵别名(?:[崩星]铁)?设置$"
      }
    },
    {
      "id": "alias-remove",
      "name": "删除别名",
      "description": "删除自定义别名，预设别名不能删除",
      "usage": "#喵喵别名删除 别名 / #删除别名 别名",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:喵喵别名(?:[崩星]铁)?删除|删除(?:别名|昵称)(?P<alias>.+))$"
      }
    },
    {
      "id": "alias-list",
      "name": "别名列表",
      "description": "查看星铁全部自定义别名",
      "usage": "#喵喵别名列表",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^喵喵别名(?:[崩星]铁)?列表$"
      }
    },
    {
      "id": "alias-add",
      "name": "添加别名",
      "description": "给角色添加别名，随后发送别名，多个用空格隔开",
      "usage": "#设置希儿别名",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:设置|配置|添加)(?P<character>.+)(?:别名|昵称)$"
      }
    },
    {
      "id": "aliases",
      "name": "角色别名",
      "description": "查看角色的全部别名",
      "usage": "#希儿别名",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?P<character>.+?)(?:别名|昵称)$"
      }
    },
    {
      "id": "simulation-history",
      "name": "模拟记录",
      "description": "查看本人的模拟抽卡记录",
      "usage": "#模拟记录 ",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "模拟记录"
        ]
      }
    },
    {
      "id": "simulation-reset",
      "name": "重置模拟",
      "description": "清空本人的模拟抽卡记录",
      "usage": "#重置模拟 确认",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "重置模拟"
        ]
      }
    },
    {
      "id": "signin",
      "name": "签到",
      "description": "游戏每日签到，领取签到奖励",
      "usage": "#签到 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "签到",
          "游戏签到"
        ]
      }
    },
    {
      "id": "signin-status",
      "name": "签到状态",
      "description": "查看本月游戏签到情况",
      "usage": "#签到状态 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "签到状态",
          "签到查询"
        ]
      }
    },
    {
      "id": "signin-task",
      "name": "自动签到",
      "description": "显式开启或停止每日自动签到",
      "usage": "#自动签到 开启/关闭 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "自动签到"
        ]
      }
    },
    {
      "id": "public-profile",
      "name": "公开信息",
      "description": "用本人主动共享的查询账号查看任意 UID 的公开资料",
      "usage": "#公开信息 UID [区服]",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "公开信息"
        ]
      }
    },
    {
      "id": "cloud-verify-code",
      "name": "ark绑定星铁uid",
      "description": "向 ark 获取当前 UID 的验证码，设为游戏签名后用于验证 UID 拥有者",
      "usage": "#ark绑定星铁uid",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "ark绑定星铁uid"
        ]
      }
    },
    {
      "id": "cloud-verify",
      "name": "ark验证星铁uid",
      "description": "签名生效后由 ark 验证 UID 拥有者，通过后 UID 与 QQ 绑定（仅 OneBot11）",
      "usage": "#ark验证星铁uid",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "ark验证星铁uid"
        ]
      }
    },
    {
      "id": "gacha-background",
      "name": "更新跃迁记录",
      "description": "按 StarRail-plugin 用最近发送的抽卡链接重新读取跃迁记录，同一 UID 一小时一次",
      "usage": "*更新跃迁记录",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "更新跃迁记录",
          "更新跃迁",
          "更新抽卡",
          "更新抽卡记录"
        ]
      }
    },
    {
      "id": "gacha-export",
      "name": "导出记录",
      "description": "导出跃迁记录为 UIGF 文件",
      "usage": "#导出记录 [v2]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:星铁)?(?P<force>强制)?导出记录(?:json)?(?P<version>v2|v4)?$"
      }
    },
    {
      "id": "gacha-import",
      "name": "导入记录",
      "description": "发送 UIGF 或 SRGF 文件导入跃迁记录",
      "usage": "#导入记录",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:星铁)?(?P<force>强制)?导入记录(?:json)?$"
      }
    },
    {
      "id": "challenge-submit",
      "name": "提交挑战",
