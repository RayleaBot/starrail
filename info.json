      "description": "ark 令牌（未配置时为匿名请求）的剩余请求额度",
      "usage": "#arktoken用量",
      "permission": "super_admin",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?i:arktoken)用量$"
      }
    },
    {
      "id": "rank-top",
      "name": "最强",
      "description": "查看本群该角色伤害第一（最高分为评分第一）的面板",
      "usage": "#最强<角色>",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:群内?)?(?:排名|排行)?(?:最强|最高|最高分|最牛|第一|极限)+.+$"
      }
    },
    {
      "id": "rank-reset",
      "name": "重置排名",
      "description": "机器人超级管理员清空本群排名或某个角色的排名",
      "usage": "#重置排名 / #重置<角色>排名",
      "permission": "super_admin",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:重置|重设).*(?:排名|排行)$"
      }
    },
    {
      "id": "rank-refresh",
      "name": "刷新排名",
      "description": "群管理员按当前规则重新计算本群记录的面板",
      "usage": "#刷新排名",
      "permission": "group_admin",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:刷新|更新|重新加载)(?:群内|群|全部)*(?:排名|排行)$"
      }
    },
    {
      "id": "rank-switch",
      "name": "开启排名",
      "description": "群管理员开启或关闭本群排名的查询",
      "usage": "#<开启|关闭>排名",
      "permission": "group_admin",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:开启|打开|启用|关闭|禁用)(?:群内|群|全部)*(?:排名|排行)$"
      }
    },
    {
      "id": "rank",
      "name": "排名",
      "description": "本群在群内查看过的面板按伤害排行，带“遗器”“评分”按遗器评分；不写角色时列出各角色第一",
      "usage": "#<角色>[遗器]排名 / #群排名",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:群内?)?.+(?:排名|排行)榜?$"
      }
    },
    {
      "id": "simulation",
      "name": "十连",
      "description": "模拟十连抽卡，娱乐用，不消耗真实货币；写联动时抽 Fate 联动池",
      "usage": "#十连[角色|光锥|常驻|联动|联动光锥]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:模拟)?(?:抽卡|十连)(?:角色|光锥|常驻|联动角色|联动光锥|联动)?$"
      }
    },
    {
      "id": "search",
      "name": "米游社",
      "description": "搜索米游社帖子",
      "usage": "#米游社<关键词>",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:搜索|(?:米游社|mys)(?P<keyword>.+))$"
      }
    },
    {
      "id": "guide-help",
      "name": "攻略帮助",
      "description": "攻略的写法、来源序号与当前默认来源",
      "usage": "#攻略帮助",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "攻略帮助",
          "攻略说明",
          "攻略"
        ]
      }
    },
    {
      "id": "guide-default",
      "name": "设置默认攻略",
      "description": "设置默认使用的攻略来源序号",
      "usage": "#设置默认攻略<来源序号>",
      "permission": "super_admin",
      "trigger": {
        "type": "pattern",
        "pattern": "^设置默认攻略(?P<source>[0-9]+)?$"
      }
    },
    {
      "id": "income-curve",
      "name": "收益曲线",
      "description": "攻击、暴击、减防等属性的收益曲线图（理论计算，不随版本变化）",
      "usage": "#收益曲线",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "收益曲线"
        ]
      }
    },
    {
      "id": "guides",
      "name": "攻略",
      "description": "发送米游社攻略合集中该角色的攻略图；可接来源序号，all 依次发送各来源，“更新”重新查找",
      "usage": "#[更新]<角色>攻略[来源序号|all]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:更新)?(?P<character>.*?)攻略(?:[0-9]+|all)?$"
      }
    },
    {
      "id": "catalog",
      "name": "图鉴",
      "description": "查看资料；角色按 miao 星铁角色图鉴页出图，其他条目在已下载 Atlas 星铁图鉴时发送对应图鉴图",
      "usage": "#<名称>图鉴",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?P<name>.*?)(?:图鉴|资料)$"
      }
    },
    {
      "id": "panel-help",
      "name": "面板帮助",
      "description": "更新面板、查看面板与伤害、换装和排名的写法",
      "usage": "#面板帮助",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "面板帮助",
          "面版帮助",
          "角色面板帮助",
          "角色面版帮助",
          "换面板帮助",
          "更换面板帮助",
          "换面版帮助",
          "更换面版帮助"
        ]
      }
    },
    {
      "id": "panel-image-upload",
      "name": "上传面板图",
      "description": "把消息或所引用消息中的图片加入角色面板图，面板随机使用",
      "usage": "#上传<角色>面板图",
      "permission": "super_admin",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:上传|添加)(?P<character>.+)面板图$"
      }
    },
    {
      "id": "panel-image-remove",
      "name": "删除面板图",
      "description": "按面板图列表的序号删除角色面板图",
      "usage": "#删除<角色>面板图<序号>",
      "permission": "super_admin",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:移除|清除|删除)(?P<character>.+)面板图(?P<index>[0-9]+)$"
      }
    },
    {
      "id": "panel-image-list",
      "name": "面板图列表",
      "description": "查看角色的面板图及序号",
      "usage": "#<角色>面板图列表",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?P<character>.+)面板图列表$"
      }
    },
    {
      "id": "panel",
      "name": "面板",
      "description": "角色面板图：属性、光锥、遗器评分与参考伤害；角色名后写详情、详细、面版、圣遗物，或写“评分 角色”，结果相同",
      "usage": "#<角色>面板 [UID] / #<角色>遗器 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:评分|(?P<character>.+?)(?:面板|面版|详情|详细|遗器|圣遗物)(?P<uid>[0-9]{9,10})?)$"
      }
    },
    {
      "id": "panel-change",
      "name": "面板换装",
      "description": "在角色名后写“换”与要换的光锥、遗器、套装、星魂、行迹或等级（如换满命换满行迹）后重新计算；附带或引用遗器截图时换上 ark 识别的遗器",
      "usage": "#<角色>换<替换内容>",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^.+换.+$"
      }
    },
    {
      "id": "character-card",
      "name": "角色卡片",
      "description": "直接发送角色名（可带卡片、UID）出角色卡片：照片、等级、星魂、光锥、技能与遗器；其他命令都不匹配时才生效",
      "usage": "#<角色>[卡片] [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^.+$",
        "fallback": true
      }
    }
  ],
